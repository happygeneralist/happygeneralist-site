---
import BaseLayout from './BaseLayout.astro'

interface Download {
  label: string
  href: string
  type?: string
}

interface ImageAsset {
  src: string
  alt: string
  caption?: string
}

interface Props {
  title: string
  description: string
  date?: Date
  status?: string
  themes?: string[]
  toolType?: string
  useWhen?: string[]
  helpsWith?: string[]
  inputs?: string[]
  outputs?: string[]
  downloads?: Download[]
  previewImage?: ImageAsset
}

const {
  title,
  description,
  date,
  status,
  themes = [],
  toolType = 'tool',
  useWhen = [],
  helpsWith = [],
  inputs = [],
  outputs = [],
  downloads = [],
  previewImage
} = Astro.props

const primaryDownload = downloads[0]
---

<BaseLayout title={title} description={description}>
  <article class="tool-page">
    <header class="tool-hero">
      <div class="tool-hero__content">
        <p class="meta">{toolType}{status ? ` - ${status}` : ''}{date ? ` - ${date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}` : ''}</p>
        <h1>{title}</h1>
        <p class="tool-hero__lede">{description}</p>
        {themes.length > 0 && (
          <ul class="tag-list" aria-label="Themes">
            {themes.map((theme) => <li class="tag">{theme}</li>)}
          </ul>
        )}
        {primaryDownload && (
          <p class="tool-hero__action">
            <a class="button" href={primaryDownload.href}>{primaryDownload.label}</a>
          </p>
        )}
      </div>
    </header>

    {previewImage && (
      <figure class="tool-preview">
        <img src={previewImage.src} alt={previewImage.alt} loading="lazy" decoding="async" />
        {previewImage.caption && <figcaption>{previewImage.caption}</figcaption>}
      </figure>
    )}

    <section class="tool-modules" aria-label="Tool overview">
      {useWhen.length > 0 && (
        <section class="tool-module">
          <h2>Use it when</h2>
          <ul>
            {useWhen.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {helpsWith.length > 0 && (
        <section class="tool-module">
          <h2>Helps with</h2>
          <ul>
            {helpsWith.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {outputs.length > 0 && (
        <section class="tool-module">
          <h2>What you get</h2>
          <ul>
            {outputs.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {inputs.length > 0 && (
        <section class="tool-module">
          <h2>What you need</h2>
          <ul>
            {inputs.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}
    </section>

    <div class="tool-body">
      <div class="tool-body__main prose">
        <slot />
      </div>

      {downloads.length > 0 && (
        <aside class="tool-download-panel" aria-label="Download this tool">
          <h2>Start using it</h2>
          <p>Download the canvas and use it as a shared framing artefact with your team.</p>
          <ul class="download-list">
            {downloads.map((download) => (
              <li>
                <a class="button" href={download.href}>{download.label}</a>
                {download.type && <span>{download.type}</span>}
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
