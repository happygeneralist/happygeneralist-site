---
import '../styles/global.css'
import '../styles/primitives.css'
import '../styles/responsive-image.css'
import '../styles/longform.css'
import '../styles/lab.css'
import '../styles/need-vector-explorer.css'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Happygeneralist: public thinking, tools, labs and civic design experiments.' } = Astro.props
const pageTitle = title === 'Happygeneralist' ? title : `${title} - Happygeneralist`
const isHome = title === 'Happygeneralist'
const base = import.meta.env.BASE_URL
const href = (path: string) => `${base}${path}`.replace(/\/\/+/g, '/')
const asset = href
const brandImage = isHome ? 'images/brand/happygeneralist-logo-full.png' : 'images/brand/happygeneralist-mark.png'
const analyticsId = 'G-SG2T4HKS6S'
const productionSite = Astro.site ?? new URL('https://happygeneralist.com')
const canonicalUrl = new URL(Astro.url.pathname, productionSite).href
const sitemapUrl = new URL('sitemap-index.xml', productionSite).href
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <title>{pageTitle}</title>
    {import.meta.env.PROD && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class={isHome ? 'site-brand site-brand--full' : 'site-brand site-brand--mark'} href={base} aria-label="Happygeneralist home">
          <img src={asset(brandImage)} alt="" />
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={href('tools/')}>Tools</a>
          <a href={href('labs/')}>Labs</a>
          <a href={href('notebook/')}>Notebook</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>Happygeneralist is a public thinking space for design, civic systems, tools and experiments.</p>
        <p><a href={href('about/')}>About Happygeneralist</a></p>
      </div>
    </footer>
  </body>
</html>
