---
interface Props {
  title: string
  children?: unknown
  label?: string
}

const { title, label = 'Definition' } = Astro.props
---

<aside class="definition-card" aria-label={`${label}: ${title}`}>
  <p class="definition-card__label">{label}</p>
  <h2 class="definition-card__title">{title}</h2>
  <div class="definition-card__body">
    <slot />
  </div>
</aside>
