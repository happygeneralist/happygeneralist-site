---
interface Props {
  caption?: string
  columns: string[]
  rows: string[][]
}

const { caption, columns, rows } = Astro.props
const tableLabel = caption ?? 'Content table'
---

<div class="content-table" role="region" aria-label={tableLabel} tabindex="0">
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {columns.map((column) => <th scope="col">{column}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell) => <td>{cell}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
