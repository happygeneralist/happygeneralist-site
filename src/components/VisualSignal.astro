---
interface Props {
  src: string
  alt: string
  caption?: string
  variant?: 'wide' | 'standard'
}

const { src, alt, caption, variant = 'wide' } = Astro.props
const className = variant === 'wide' ? 'visual-signal visual-signal--wide' : 'visual-signal'
const base = import.meta.env.BASE_URL
const resolvedSrc = src.startsWith('http://') || src.startsWith('https://')
  ? src
  : `${base}${src.replace(/^\//, '')}`.replace(/\/\/+/g, '/')
---

<figure class={className}>
  <img src={resolvedSrc} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
