---
interface Props {
  src: string
  alt: string
  caption?: string
  variant?: 'wide' | 'standard'
}

const { src, alt, caption, variant = 'wide' } = Astro.props
const className = variant === 'wide' ? 'visual-signal visual-signal--wide' : 'visual-signal'
---

<figure class={className}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
