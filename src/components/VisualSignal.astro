---
import ResponsiveImage from './ResponsiveImage.astro'

interface Props {
  src: string
  alt: string
  caption?: string
  variant?: 'wide' | 'standard'
}

const { src, alt, caption, variant = 'wide' } = Astro.props
---

<ResponsiveImage
  src={src}
  alt={alt}
  caption={caption}
  variant={variant}
  sizes={variant === 'wide' ? '(min-width: 1100px) 1100px, calc(100vw - 2rem)' : '(min-width: 760px) 680px, calc(100vw - 2rem)'}
/>
