---
import { Picture } from 'astro:assets'

type Loading = 'eager' | 'lazy'
type Variant = 'standard' | 'wide' | 'tool-preview' | 'longform-hero' | 'lab-preview' | 'lab-index-preview'

interface Props {
  src: string
  alt: string
  caption?: string
  label?: string
  variant?: Variant
  loading?: Loading
  widths?: number[]
  sizes?: string
}

const {
  src,
  alt,
  caption,
  label,
  variant = 'standard',
  loading = 'lazy',
  widths = [480, 768, 1024, 1440, 1920],
  sizes = '(min-width: 1320px) 1320px, calc(100vw - 2rem)'
} = Astro.props

const imageModules = import.meta.glob('../assets/images/**/*.{png,jpg,jpeg,webp,avif}', { eager: true }) as Record<string, { default: any }>
const normalisedSrc = src.replace(/^\//, '')
const assetKey = normalisedSrc.startsWith('src/assets/images/')
  ? `../assets/images/${normalisedSrc.replace('src/assets/images/', '')}`
  : `../assets/images/${normalisedSrc}`
const assetAliases: Record<string, string> = {
  '../assets/images/notebook/lean-provocations/exconf-lean-provocations-hero.webp': '../assets/images/notebook/lean-provocations/lean-provocations-exconf-hero.webp'
}
const imageModule = imageModules[assetKey] ?? imageModules[assetAliases[assetKey]]
const base = import.meta.env.BASE_URL
const fallbackSrc = src.startsWith('http://') || src.startsWith('https://')
  ? src
  : `${base}${src.replace(/^\//, '')}`.replace(/\/\/+/g, '/')
const className = `responsive-image responsive-image--${variant}`
---

<figure class={className}>
  {label && <span class="responsive-image__label">{label}</span>}
  {imageModule ? (
    <Picture
      src={imageModule.default}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={loading}
      decoding="async"
    />
  ) : (
    <img src={fallbackSrc} alt={alt} loading={loading} decoding="async" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
