---
import { getCollection, render } from 'astro:content'
import ContentLayout from '../../layouts/ContentLayout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('ideas')
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<ContentLayout title={entry.data.title} description={entry.data.description} date={entry.data.date} status={entry.data.status} themes={entry.data.themes}>
  <Content />
</ContentLayout>
