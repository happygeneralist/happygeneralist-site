---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ResponsiveImage from '../../components/ResponsiveImage.astro'

const base = import.meta.env.BASE_URL
const href = (path: string) => `${base}${path}`.replace(/\/\/+/g, '/')
const entries = await getCollection('labs')
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout title="Labs" description="Applied experiments, case studies, prototypes and complex use cases.">
  <section class="page">
    <header class="page-header prose">
      <h1>Labs</h1>
      <p>Applied experiments, case studies, prototypes and complex use cases.</p>
    </header>
    <div class="card-grid">
      {entries.map((entry) => (
        <article class="card">
          {entry.data.preview_image && (
            <ResponsiveImage
              src={entry.data.preview_image.src}
              alt={entry.data.preview_image.alt}
              caption={entry.data.preview_image.caption}
              variant="lab-preview"
              sizes="(min-width: 1000px) 25vw, (min-width: 600px) 40vw, calc(100vw - 4rem)"
            />
          )}
          <p class="meta">{entry.data.lab_type} - {entry.data.project_status}</p>
          <h2><a href={href(`labs/${entry.id}/`)}>{entry.data.title}</a></h2>
          <p>{entry.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
