---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ResponsiveImage from '../../components/ResponsiveImage.astro'

const base = import.meta.env.BASE_URL
const href = (path: string) => `${base}${path}`.replace(/\/\/+/g, '/')
const entries = await getCollection('labs')
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const formatLabel = (value: string) => value
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (character) => character.toUpperCase())
---

<BaseLayout title="Labs" description="Applied experiments, case studies, prototypes and complex use cases.">
  <section class="page labs-index">
    <header class="page-header prose labs-index__header">
      <h1>Labs</h1>
      <p>Applied experiments, case studies, prototypes and complex use cases.</p>
    </header>
    <ul class="labs-index__list">
      {entries.map((entry) => (
        <li>
          <a
            class="labs-index-card__link"
            href={href(`labs/${entry.id}/`)}
            aria-label={`${entry.data.title}: ${entry.data.description}`}
          >
            <article class:list={['labs-index-card', { 'labs-index-card--with-image': Boolean(entry.data.preview_image) }]}>
              {entry.data.preview_image && (
                <div class="labs-index-card__media">
                  <ResponsiveImage
                    src={entry.data.preview_image.src}
                    alt={entry.data.preview_image.alt}
                    variant="lab-index-preview"
                    sizes="(min-width: 900px) 24rem, (min-width: 600px) 40vw, calc(100vw - 4rem)"
                  />
                </div>
              )}
              <div class="labs-index-card__content">
                <p class="labs-index-card__meta">{formatLabel(entry.data.lab_type)} <span aria-hidden="true">·</span> {formatLabel(entry.data.project_status)}</p>
                <h2 class="labs-index-card__title">{entry.data.title}</h2>
                <p class="labs-index-card__description">{entry.data.description}</p>
              </div>
            </article>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
