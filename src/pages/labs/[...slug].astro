---
import { getCollection, render } from 'astro:content'
import ContentLayout from '../../layouts/ContentLayout.astro'
import LabLayout from '../../layouts/LabLayout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('labs')
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const useLabLayout = entry.data.layout !== 'standard'
---

{useLabLayout ? (
  <LabLayout title={entry.data.title} description={entry.data.description} status={entry.data.project_status} themes={entry.data.themes}>
    <section class="card lab-panel lab-panel--wide prose">
      <Content />
    </section>
  </LabLayout>
) : (
  <ContentLayout title={entry.data.title} description={entry.data.description} date={entry.data.date} status={entry.data.project_status} themes={entry.data.themes}>
    <Content />
  </ContentLayout>
)}
