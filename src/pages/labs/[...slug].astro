---
import { getCollection, render } from 'astro:content'
import ContentLayout from '../../layouts/ContentLayout.astro'
import LabLayout from '../../layouts/LabLayout.astro'
import UnignorableAnalysisGrid from '../../components/UnignorableAnalysisGrid.astro'

export async function getStaticPaths() {
  const entries = await getCollection('labs')
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const useLabLayout = entry.data.layout !== 'standard'
---

{useLabLayout ? (
  <LabLayout
    title={entry.data.title}
    description={entry.data.description}
    status={entry.data.project_status}
    themes={entry.data.themes}
    previewImage={entry.data.preview_image}
  >
    <Content />
    {entry.id === 'unignorable' && (
      <section class="lab-panel lab-panel--wide">
        <h2>Analysis archive</h2>
        <p>Some applications of the framework are published as downloadable analysis artefacts rather than ordinary site content.</p>
        <p>The archive holds short catalogue notes and links to PDFs. The PDFs preserve each analysis as a standalone artefact, with sidecar metadata for future indexing.</p>
        <UnignorableAnalysisGrid />
        <p><a href="/notebook/unignorable-analysis-archive/">View the full Unignorable analysis archive</a></p>
      </section>
    )}
  </LabLayout>
) : (
  <ContentLayout
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.date}
    status={entry.data.project_status}
    themes={entry.data.themes}
  >
    <Content />
  </ContentLayout>
)}
