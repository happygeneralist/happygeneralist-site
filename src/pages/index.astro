---
import BaseLayout from '../layouts/BaseLayout.astro'

const sections = [
  {
    title: 'Notebook',
    href: '/notebook/',
    description: 'Working thoughts, observations, fragments and early patterns.'
  },
  {
    title: 'Ideas',
    href: '/ideas/',
    description: 'Short concepts, distinctions, provocations and named frames.'
  },
  {
    title: 'Tools',
    href: '/tools/',
    description: 'Canvases, methods, prompts, frameworks and reusable structures.'
  },
  {
    title: 'Labs',
    href: '/labs/',
    description: 'Applied experiments, case studies, prototypes and complex use cases.'
  }
]
---

<BaseLayout title="Happygeneralist">
  <section class="page">
    <header class="page-header prose">
      <h1>Public thinking, tools and experiments for civic design.</h1>
      <p>Happygeneralist is a working space for making complex ideas clearer, more usable and more alive.</p>
    </header>

    <div class="card-grid">
      {sections.map((section) => (
        <article class="card">
          <h2><a href={section.href}>{section.title}</a></h2>
          <p>{section.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
