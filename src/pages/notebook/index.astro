---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

const base = import.meta.env.BASE_URL
const href = (path: string) => `${base}${path}`.replace(/\/\/+/g, '/')
const entries = await getCollection('notebook')
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout title="Notebook" description="Working thoughts, observations, fragments and early patterns.">
  <section class="page">
    <header class="page-header prose">
      <h1>Notebook</h1>
      <p>Working thoughts, observations, fragments and early patterns.</p>
    </header>

    <section aria-labelledby="notebook-categories-heading" style="margin-bottom: var(--space-7);">
      <div class="prose">
        <h2 id="notebook-categories-heading">Notebook paths</h2>
      </div>
      <div class="card-grid">
        <article class="card">
          <p class="meta">category</p>
          <h3><a href={href('notebook/pathologies-of-practice/')}>Pathologies of practice</a></h3>
          <p>Recurring dysfunctions in governance, policy, finance and institutional life.</p>
        </article>
        <article class="card">
          <p class="meta">category</p>
          <h3><a href={href('notebook/user-needs-patterns/')}>User needs patterns</a></h3>
          <p>Working definitions, failure modes and governance questions around user needs, civic needs and evidence-to-decision traceability.</p>
        </article>
      </div>
    </section>

    <section aria-labelledby="notebook-entries-heading">
      <div class="prose">
        <h2 id="notebook-entries-heading">Entries</h2>
      </div>
      <div class="card-grid">
        {entries.map((entry) => (
          <article class="card">
            <p class="meta">{entry.data.status}</p>
            <h3><a href={href(`notebook/${entry.id}/`)}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
