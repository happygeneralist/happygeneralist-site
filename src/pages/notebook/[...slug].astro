---
import { getCollection, render } from 'astro:content'
import ContentLayout from '../../layouts/ContentLayout.astro'
import LongformNotebookLayout from '../../layouts/LongformNotebookLayout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('notebook')
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const isLongform = entry.data.entry_type === 'longform' || entry.data.layout_variant === 'longform'
---

{isLongform ? (
  <LongformNotebookLayout
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.date}
    status={entry.data.status}
    themes={entry.data.themes}
    originNote={entry.data.origin_note}
    sections={entry.data.sections}
    extracts={entry.data.extracts}
  >
    <Content />
  </LongformNotebookLayout>
) : (
  <ContentLayout title={entry.data.title} description={entry.data.description} date={entry.data.date} status={entry.data.status} themes={entry.data.themes}>
    <Content />
  </ContentLayout>
)}
