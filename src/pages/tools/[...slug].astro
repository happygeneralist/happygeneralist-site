---
import { getCollection, render } from 'astro:content'
import ToolLayout from '../../layouts/ToolLayout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('tools')
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<ToolLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  status={entry.data.status}
  themes={entry.data.themes}
  toolType={entry.data.tool_type}
  useWhen={entry.data.use_when}
  helpsWith={entry.data.helps_with}
  inputs={entry.data.inputs}
  outputs={entry.data.outputs}
  downloads={entry.data.downloads}
  previewImage={entry.data.preview_image}
>
  <Content />
</ToolLayout>
