---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

const base = import.meta.env.BASE_URL
const href = (path: string) => `${base}${path}`.replace(/\/\/+/g, '/')
const entries = await getCollection('tools')
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout title="Tools" description="Canvases, methods, prompts, frameworks and reusable structures.">
  <section class="page">
    <header class="page-header prose">
      <h1>Tools</h1>
      <p>Canvases, methods, prompts, frameworks and reusable structures.</p>
    </header>
    <div class="card-grid">
      {entries.map((entry) => (
        <article class="card">
          <p class="meta">{entry.data.tool_type} - {entry.data.status}</p>
          <h2><a href={href(`tools/${entry.id}/`)}>{entry.data.title}</a></h2>
          <p>{entry.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
